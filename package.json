{
  "name": "remitee-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "build": "forge build --root contracts && tsc --noEmit",
    "test:contract": "forge test --root contracts",
    "test:api": "vitest run",
    "test": "npm run test:contract && npm run test:api",
    "coverage:contract": "mkdir -p coverage && forge coverage --root contracts --report summary --report lcov --report-file ../coverage/contracts.lcov",
    "coverage:api": "vitest run --coverage",
    "local": "tsx scripts/local.ts",
    "api:start": "tsx api/src/main.ts",
    "healthcheck": "tsx scripts/healthcheck-cli.ts",
    "indexer:rebuild": "tsx scripts/rebuild.ts",
    "smoke": "tsx scripts/smoke.ts",
    "demo": "tsx scripts/demo.ts",
    "test:integration": "tsx scripts/integration.ts",
    "deploy:sepolia:dry-run": "tsx scripts/sepolia.ts dry-run",
    "deploy:sepolia": "tsx scripts/sepolia.ts broadcast",
    "verify:sepolia:etherscan": "tsx scripts/sepolia.ts etherscan",
    "verify:sepolia:blockscout": "tsx scripts/sepolia.ts blockscout",
    "format": "prettier --write \"api/**/*.ts\" \"scripts/**/*.ts\" vitest.config.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "better-sqlite3": "12.4.1",
    "ethers": "6.17.0",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
